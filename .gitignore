# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Apple Wallet pass (generated artefact — regenerate from wallet/ + certs)
public/gileslamb-card.pkpass

# Apple Wallet signing certs: never commit (folder kept via .gitkeep)
wallet/certs/*
!wallet/certs/.gitkeep
*.p12

# local tooling
.wrangler/
.claude/
.shotK-tmp.mjs

# local screenshots
desk*.png
mob-full.png
play-*.png
